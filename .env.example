# Copiá este archivo a .env (local) y configurá los mismos valores en
# Vercel → Project Settings → Environment Variables para producción.

# --- Base de datos (Postgres, ej. Supabase Database o cualquier Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/biodieselos?schema=public"
# Igual a DATABASE_URL salvo si usás pgbouncer/pooling (ej. Supabase): ahí
# DIRECT_URL debe apuntar a la conexión directa (puerto 5432, sin pooler),
# porque las migraciones de Prisma no funcionan a través de un connection pooler.
DIRECT_URL="postgresql://user:password@host:5432/biodieselos?schema=public"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Solo necesaria si en el futuro se llama a la Admin API de Supabase
# (ej. para setear user_metadata.role='ADMIN' de forma programática).
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Cron (Vercel Cron -> /api/cron/iscc-check, ver vercel.json) ---
# Opcional pero recomendado: si se define, el endpoint exige este bearer
# token en el header Authorization. Vercel lo inyecta automáticamente en
# sus crons si configurás la env var con el mismo nombre.
CRON_SECRET=""
